#include "lcd_i2c.h"
#include "main.h"

#define LCD_ADDR (0x27 << 1)  // Change to 0x3F<<1 if needed

static I2C_HandleTypeDef *lcd_i2c;

void LCD_SendCmd(uint8_t cmd)
{
    uint8_t data[2];
    data[0] = 0x00;  // Control byte: command
    data[1] = cmd;
    HAL_I2C_Master_Transmit(lcd_i2c, LCD_ADDR, data, 2, HAL_MAX_DELAY);
}

void LCD_SendData(uint8_t data)
{
    uint8_t buff[2];
    buff[0] = 0x40;  // Control byte: data
    buff[1] = data;
    HAL_I2C_Master_Transmit(lcd_i2c, LCD_ADDR, buff, 2, HAL_MAX_DELAY);
}

void LCD_Init(I2C_HandleTypeDef *hi2c)
{
    lcd_i2c = hi2c;
    HAL_Delay(50);

    LCD_SendCmd(0x38);  // 8-bit, 2 lines, 5x8 dots
    LCD_SendCmd(0x0C);  // Display ON, no cursor
    LCD_SendCmd(0x01);  // Clear display
    HAL_Delay(2);
}

void LCD_Clear(void)
{
    LCD_SendCmd(0x01);
    HAL_Delay(2);
}

void LCD_SetCursor(uint8_t row, uint8_t col)
{
    uint8_t pos = (row == 0) ? (0x80 + col) : (0xC0 + col);
    LCD_SendCmd(pos);
}

void LCD_Print(char *str)
{
    while (*str)
    {
        LCD_SendData(*str++);
    }
}
