#include "lcd_i2c.h"
#include "string.h"

#define LCD_ADDR 0x27 << 1  // Typical I2C address

static I2C_HandleTypeDef *lcd_i2c;

void LCD_Send_Cmd(char cmd) {
    uint8_t data[2] = {0x80, cmd};
    HAL_I2C_Master_Transmit(lcd_i2c, LCD_ADDR, data, 2, 100);
}

void LCD_Send_Data(char data) {
    uint8_t buff[2] = {0x40, data};
    HAL_I2C_Master_Transmit(lcd_i2c, LCD_ADDR, buff, 2, 100);
}

void LCD_Init(I2C_HandleTypeDef *hi2c) {
    lcd_i2c = hi2c;
    HAL_Delay(50);
    LCD_Send_Cmd(0x38);
    LCD_Send_Cmd(0x0C);
    LCD_Send_Cmd(0x01);
    HAL_Delay(2);
}

void LCD_Send_String(char *str) {
    while (*str) LCD_Send_Data(*str++);
}

void LCD_Clear(void) {
    LCD_Send_Cmd(0x01);
    HAL_Delay(2);
}

void LCD_Set_Cursor(uint8_t row, uint8_t col) {
    uint8_t pos = (row == 1) ? (0x80 + col) : (0xC0 + col);
    LCD_Send_Cmd(pos);
}
