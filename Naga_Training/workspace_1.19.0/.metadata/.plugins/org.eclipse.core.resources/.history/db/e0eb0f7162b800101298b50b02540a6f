#include "lcd_i2c.h"

// PCF8574 bit mapping used here (very common):
// P7..P4 = D7..D4 (data high nibble), P3=Backlight, P2=EN, P1=RW, P0=RS
#define LCD_BL   0x08
#define LCD_EN   0x04
#define LCD_RW   0x02
#define LCD_RS   0x01

static I2C_HandleTypeDef *h = NULL;
static uint8_t backlight = LCD_BL;

static void i2c_write(uint8_t data)
{
    HAL_I2C_Master_Transmit(h, LCD_I2C_ADDR, &data, 1, HAL_MAX_DELAY);
}

static void lcd_pulse(uint8_t data)
{
    i2c_write(data | LCD_EN);
    HAL_Delay(1);
    i2c_write(data & ~LCD_EN);
    HAL_Delay(1);
}

static void lcd_write4(uint8_t nibble, uint8_t rs)
{
    uint8_t d = ((nibble & 0x0F) << 4) | backlight | (rs ? LCD_RS : 0); // RW=0 always
    lcd_pulse(d);
}

static void lcd_cmd(uint8_t cmd)
{
    lcd_write4(cmd >> 4, 0);
    lcd_write4(cmd & 0x0F, 0);
    HAL_Delay(2);
}

static void lcd_data(uint8_t data)
{
    lcd_write4(data >> 4, 1);
    lcd_write4(data & 0x0F, 1);
}

void LCD_Backlight(uint8_t on)
{
    backlight = on ? LCD_BL : 0x00;
    // write a NOP to latch new BL state
    i2c_write(backlight);
}

void LCD_Init(I2C_HandleTypeDef *hi2c)
{
    h = hi2c;
    HAL_Delay(50);

    // 4-bit init sequence
    lcd_write4(0x03, 0); HAL_Delay(5);
    lcd_write4(0x03, 0); HAL_Delay(5);
    lcd_write4(0x03, 0); HAL_Delay(5);
    lcd_write4(0x02, 0); HAL_Delay(5);      // 4-bit mode

    lcd_cmd(0x28); // Function set: 4-bit, 2 lines, 5x8 dots
    lcd_cmd(0x08); // Display OFF
    lcd_cmd(0x01); // Clear
    HAL_Delay(2);
    lcd_cmd(0x06); // Entry mode: cursor moves right
    lcd_cmd(0x0C); // Display ON, cursor OFF, blink OFF

    LCD_Backlight(1);
}

void LCD_Clear(void)
{
    lcd_cmd(0x01);
    HAL_Delay(2);
}

void LCD_SetCursor(uint8_t col, uint8_t row)
{
    static const uint8_t row_offsets[4] = {0x00, 0x40, 0x14, 0x54};
    if (row >= LCD_ROWS) row = 0;
    lcd_cmd(0x80 | (col + row_offsets[row]));
}

void LCD_Print(const char *s)
{
    while (*s) lcd_data((uint8_t)*s++);
}

void LCD_Printf(const char *fmt, ...)
{
    char buf[32];
    va_list ap;
    va_start(ap, fmt);
    vsnprintf(buf, sizeof(buf), fmt, ap);
    va_end(ap);
    LCD_Print(buf);
}
